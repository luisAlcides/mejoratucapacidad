# Plantilla de variables de entorno. Copia este archivo como .env y rellénalo.
# Genera SECRET_KEY con: python -c "import secrets; print(secrets.token_urlsafe(50))"

DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Mexico_City

# Opcional. Sin ella se usa SQLite en local.
# En Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgres://usuario:clave@localhost:5432/mejoratucapacidad

# Opcional en producción (Railway añade su dominio solo con RAILWAY_PUBLIC_DOMAIN).
# Si usas un dominio propio, añádelo aquí:
# ALLOWED_HOSTS=midominio.com
# CSRF_TRUSTED_ORIGINS=https://midominio.com
